# Builds the subset of HDiffPatch (https://github.com/sisong/HDiffPatch, MIT)
# used by bulk static deltas, and our C wrapper around it.

noinst_LTLIBRARIES += libhdiffpatch.la

libhdiffpatch_la_SOURCES = \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HDiff/diff.cpp \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HDiff/private_diff/match_block.cpp \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HDiff/private_diff/bytes_rle.cpp \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HDiff/private_diff/suffix_string.cpp \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HDiff/private_diff/compress_detect.cpp \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HDiff/private_diff/limit_mem_diff/digest_matcher.cpp \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HDiff/private_diff/limit_mem_diff/stream_serialize.cpp \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HDiff/private_diff/limit_mem_diff/adler_roll.c \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HDiff/private_diff/libdivsufsort/divsufsort.cpp \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HDiff/private_diff/libdivsufsort/divsufsort64.cpp \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HDiff/private_diff/window_diff/window_matcher.cpp \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HDiff/private_diff/window_diff/covers_range.cpp \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HPatch/patch.c \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HPatchLite/hpatch_lite.c \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HPatch/hpatch_mt/_hcache_old_mt.c \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HPatch/hpatch_mt/_hcache_window_old_mt.c \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HPatch/hpatch_mt/_hinput_mt.c \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HPatch/hpatch_mt/_houtput_mt.c \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HPatch/hpatch_mt/_hpatch_mt.c \
	$(libhdiffpatch_srcpath)/libHDiffPatch/HPatch/hpatch_mt/hpatch_mt.c \
	$(libhdiffpatch_srcpath)/libParallel/parallel_import_c.c \
	$(libhdiffpatch_srcpath)/libParallel/parallel_channel.cpp \
	$(NULL)

libhdiffpatch_cppflags = -I$(srcdir)/$(libhdiffpatch_srcpath) -D_IS_USED_MULTITHREAD=1 -D_IS_USED_PTHREAD=1 -D_IS_OUT_DIFF_INFO=0 -DNDEBUG
# Vendored code: do not apply our warning flags to it.
libhdiffpatch_la_CPPFLAGS = $(AM_CPPFLAGS) $(libhdiffpatch_cppflags)
libhdiffpatch_la_CFLAGS = $(OT_DEP_GIO_UNIX_CFLAGS) -fvisibility=hidden -w
libhdiffpatch_la_CXXFLAGS = $(OT_DEP_GIO_UNIX_CFLAGS) -fvisibility=hidden -w
libhdiffpatch_la_LIBADD = $(OT_DEP_GIO_UNIX_LIBS) -lpthread
